# AWS Credentials
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_DEFAULT_REGION=us-east-1

# Bedrock Model IDs
BEDROCK_LLM_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# DynamoDB
DYNAMODB_TABLE_NAME=chat-history
DYNAMODB_ENDPOINT_URL=  # leave blank for AWS; set to http://localhost:8000 for local DynamoDB

# Service URLs (for inter-service communication)
AGENT_ORCHESTRATOR_URL=http://agent-orchestrator:8002
MCP_SERVER_URL=http://mcp-server:8003
INGESTION_SERVICE_URL=http://ingestion-service:8001

# FAISS index storage path (inside containers)
VECTOR_STORE_PATH=/app/data/faiss_index

# Logging
LOG_LEVEL=INFO
